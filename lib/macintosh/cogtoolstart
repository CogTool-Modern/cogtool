#!/bin/bash

RESDIR="$(cd "$(dirname "$0")" && pwd)"
APPDIR="$(cd "$RESDIR/../.." && pwd)"
MAC_ARCH="$(uname -m)"

java_required() {
    local message="$1"
    local link_key download_url
    case "$MAC_ARCH" in
        arm64) link_key='java\.macos\.arm64\.url' ;;
        x86_64) link_key='java\.macos\.x64\.url' ;;
    esac
    if [[ -n "$link_key" && -r "$RESDIR/release.properties" ]]; then
        download_url=$(sed -n "s/^[[:space:]]*$link_key[[:space:]]*=[[:space:]]*//p" "$RESDIR/release.properties" | head -1)
    fi
    echo "CogTool: $message" >&2
    /usr/bin/osascript - "$message" "$download_url" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
    if item 2 of argv is "" then
        display dialog (item 1 of argv) with title "CogTool Needs Java" buttons {"Quit"} default button "Quit" with icon caution
    else
        set choice to button returned of (display dialog (item 1 of argv) with title "CogTool Needs Java" buttons {"Quit", "Download Java"} default button "Download Java" with icon caution)
        if choice is "Download Java" then open location (item 2 of argv)
    end if
end run
APPLESCRIPT
    exit 1
}

# SWT has architecture-specific native libraries. Use the architecture of
# the selected JVM, which can differ from the hardware when using Rosetta.
if [[ -n "$JAVA_HOME" && -x "$JAVA_HOME/bin/java" ]]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    # /usr/bin/java is a macOS stub, even when no runtime is installed.
    # Avoid invoking it in that case: it can display its own system prompt.
    REGISTERED_JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null)
    if [[ "$MAC_ARCH" == "arm64" ]]; then
        # java_home can fall back to an older plug-in runtime even with -v,
        # and does not always discover standalone JRE installations.
        JAVA17_HOME=$(/usr/libexec/java_home -v '17+' -a arm64 2>/dev/null)
        for JAVA_CANDIDATE in "$JAVA17_HOME/bin/java" /Library/Java/JavaVirtualMachines/*/Contents/Home/bin/java /opt/homebrew/opt/openjdk/bin/java "$(command -v java)"; do
            [[ -x "$JAVA_CANDIDATE" ]] || continue
            [[ "$JAVA_CANDIDATE" != /usr/bin/java || -n "$REGISTERED_JAVA_HOME" ]] || continue
            JAVA17_SETTINGS=$("$JAVA_CANDIDATE" -XshowSettings:properties -version 2>&1) || continue
            JAVA17_VERSION=$(printf '%s\n' "$JAVA17_SETTINGS" | sed -n 's/^[[:space:]]*java.specification.version = //p' | head -1)
            JAVA17_ARCH=$(printf '%s\n' "$JAVA17_SETTINGS" | sed -n 's/^[[:space:]]*os.arch = //p' | head -1)
            if [[ "$JAVA17_VERSION" =~ ^[0-9]+$ ]] && (( JAVA17_VERSION >= 17 )) && [[ "$JAVA17_ARCH" == "aarch64" || "$JAVA17_ARCH" == "arm64" ]]; then
                JAVACMD="$JAVA_CANDIDATE"
                break
            fi
        done
    fi
    JAVACMD="${JAVACMD:-$(command -v java)}"
    if [[ "$JAVACMD" == /usr/bin/java && -z "$REGISTERED_JAVA_HOME" ]]; then
        JAVACMD=""
    fi
fi

if [[ -z "$JAVACMD" ]]; then
    java_required "CogTool could not find Java. Install Java and try again. On Apple Silicon, CogTool requires an ARM64 Java 17 or newer runtime."
fi

if ! JAVA_SETTINGS=$("$JAVACMD" -XshowSettings:properties -version 2>&1); then
    java_required "CogTool could not start Java. Install a working Java runtime and try again. On Apple Silicon, CogTool requires ARM64 Java 17 or newer."
fi
JAVA_ARCH=$(printf '%s\n' "$JAVA_SETTINGS" | sed -n 's/^[[:space:]]*os.arch = //p' | head -1)
JAVA_VERSION=$(printf '%s\n' "$JAVA_SETTINGS" | sed -n 's/^[[:space:]]*java.specification.version = //p' | head -1)

JAVAROOT="$RESDIR/Java"
SWTJAR="$JAVAROOT/swt.jar"
NATIVEPATH="$JAVAROOT/dll"

case "$JAVA_ARCH" in
    aarch64|arm64)
        if [[ ! "$JAVA_VERSION" =~ ^[0-9]+$ ]] || (( JAVA_VERSION < 17 )); then
            java_required "CogTool on Apple Silicon requires an ARM64 Java 17 or newer runtime (found Java ${JAVA_VERSION:-unknown}). Install a compatible runtime and try again."
        fi
        SWTJAR="$JAVAROOT/swt-arm64.jar"
        NATIVEPATH="$NATIVEPATH/arm64"
        ;;
    x86_64|amd64) ;;
    *)
        echo "Unsupported Java architecture: $JAVA_ARCH" >&2
        exit 1
        ;;
esac

cd "$RESDIR" || exit 1
exec "$JAVACMD" -XstartOnFirstThread -classpath "$JAVAROOT/CogTool.jar:$JAVAROOT/MacSupport.jar:$JAVAROOT/WindowsImageTransfer.jar:$JAVAROOT/commons-collections-3.1.jar:$JAVAROOT/commons-lang-2.1.jar:$JAVAROOT/ecf.jar:$JAVAROOT/js.jar:$JAVAROOT/draw2d.jar:$SWTJAR:$JAVAROOT/xercesImpl.jar:$JAVAROOT/xml-apis.jar:$JAVAROOT/MozillaGlue.jar:$JAVAROOT/MozillaInterfaces.jar:$JAVAROOT/jopt-simple.jar" -Djava.library.path="$NATIVEPATH" -Dcogtool.app.bundle="$APPDIR" -Dcogtool.version="$BLDVER" -Dcogtool.revision="$BLDREV" -Dcogtool.build="$BLDTIM" -Xmx400000000 edu.cmu.cs.hcii.cogtool.CogTool "$@"
