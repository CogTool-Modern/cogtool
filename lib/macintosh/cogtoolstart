#!/bin/bash

# SWT has architecture-specific native libraries. Use the architecture of
# the selected JVM, which can differ from the hardware when using Rosetta.
if [[ -n "$JAVA_HOME" && -x "$JAVA_HOME/bin/java" ]]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    if [[ "$(uname -m)" == "arm64" ]]; then
        # java_home can fall back to an older plug-in runtime even with -v.
        JAVA17_HOME=$(/usr/libexec/java_home -v '17+' -a arm64 2>/dev/null)
        if [[ -x "$JAVA17_HOME/bin/java" ]]; then
            JAVA17_SETTINGS=$("$JAVA17_HOME/bin/java" -XshowSettings:properties -version 2>&1)
            JAVA17_VERSION=$(printf '%s\n' "$JAVA17_SETTINGS" | sed -n 's/^[[:space:]]*java.specification.version = //p' | head -1)
            JAVA17_ARCH=$(printf '%s\n' "$JAVA17_SETTINGS" | sed -n 's/^[[:space:]]*os.arch = //p' | head -1)
            if [[ "$JAVA17_VERSION" =~ ^[0-9]+$ ]] && (( JAVA17_VERSION >= 17 )) && [[ "$JAVA17_ARCH" == "aarch64" || "$JAVA17_ARCH" == "arm64" ]]; then
                JAVACMD="$JAVA17_HOME/bin/java"
            fi
        fi
        if [[ -z "$JAVACMD" && -x /opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home/bin/java ]]; then
            JAVACMD="/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home/bin/java"
        fi
    fi
    JAVACMD="${JAVACMD:-$(command -v java)}"
fi

if [[ -z "$JAVACMD" ]]; then
    echo "CogTool requires Java. Install an ARM64 Java 17 or newer runtime on Apple Silicon." >&2
    exit 1
fi

JAVA_SETTINGS=$("$JAVACMD" -XshowSettings:properties -version 2>&1)
JAVA_ARCH=$(printf '%s\n' "$JAVA_SETTINGS" | sed -n 's/^[[:space:]]*os.arch = //p' | head -1)
JAVA_VERSION=$(printf '%s\n' "$JAVA_SETTINGS" | sed -n 's/^[[:space:]]*java.specification.version = //p' | head -1)

RESDIR="$(cd "$(dirname "$0")" && pwd)"
JAVAROOT="$RESDIR/Java"
SWTJAR="$JAVAROOT/swt.jar"
NATIVEPATH="$JAVAROOT/dll"

case "$JAVA_ARCH" in
    aarch64|arm64)
        if [[ ! "$JAVA_VERSION" =~ ^[0-9]+$ ]] || (( JAVA_VERSION < 17 )); then
            echo "CogTool on Apple Silicon requires an ARM64 Java 17 or newer runtime (found Java $JAVA_VERSION)." >&2
            exit 1
        fi
        SWTJAR="$JAVAROOT/swt-arm64.jar"
        NATIVEPATH="$NATIVEPATH/arm64"
        ;;
    x86_64|amd64) ;;
    *)
        echo "Unsupported Java architecture: $JAVA_ARCH" >&2
        exit 1
        ;;
esac

cd "$RESDIR" || exit 1
exec "$JAVACMD" -XstartOnFirstThread -classpath "$JAVAROOT/CogTool.jar:$JAVAROOT/MacSupport.jar:$JAVAROOT/WindowsImageTransfer.jar:$JAVAROOT/commons-collections-3.1.jar:$JAVAROOT/commons-lang-2.1.jar:$JAVAROOT/ecf.jar:$JAVAROOT/js.jar:$JAVAROOT/draw2d.jar:$SWTJAR:$JAVAROOT/xercesImpl.jar:$JAVAROOT/xml-apis.jar:$JAVAROOT/MozillaGlue.jar:$JAVAROOT/MozillaInterfaces.jar:$JAVAROOT/jopt-simple.jar" -Djava.library.path="$NATIVEPATH" -Dcogtool.version="$BLDVER" -Dcogtool.revision="$BLDREV" -Dcogtool.build="$BLDTIM" -Xmx400000000 edu.cmu.cs.hcii.cogtool.CogTool "$@"
