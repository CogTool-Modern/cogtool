<?xml version="1.0" encoding="UTF-8"?>

<project name="CogTool" default="package-all">

        <defaultexcludes echo="true"/>

	<!-- Local paths can be configured without changing the shared build. -->
	<property environment="env" />
	<property file="${basedir}/build.local.properties" />
	<condition property="windows.tools.path" value="${windows.msitools.bin}${path.separator}${env.PATH}" else="${env.PATH}">
		<isset property="windows.msitools.bin" />
	</condition>
	<!-- This file is also packaged as a runtime resource. -->
	<property prefix="release" file="${basedir}/java/edu/cmu/cs/hcii/cogtool/resources/release.properties" />
	<property file="${basedir}/java/edu/cmu/cs/hcii/cogtool/resources/release.properties" />
	<!-- A build may supply -Drevision=...; otherwise no revision is displayed. -->
	<property name="revision" value="unspecified" />
	<condition property="revision.suffix" value="-r${revision}" else="">
		<not><equals arg1="${revision}" arg2="unspecified" /></not>
	</condition>
	<loadresource property="exeversion">
		<string value="${version}.0.0.0" />
		<filterchain><tokenfilter><replaceregex pattern="^([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+).*$" replace="\1" /></tokenfilter></filterchain>
	</loadresource>
	<loadresource property="versionclean">
		<string value="${version}" />
		<filterchain><tokenfilter><replaceregex pattern="\." replace="_" flags="g" /></tokenfilter></filterchain>
	</loadresource>

	<property name="jlevel" value="1.8" />
    <property name="build.compiler" value="javac${jlevel}" />

	<property name="srcroot" value="${basedir}/java" />
	<property name="macsrcroot" value="${basedir}/mac-support" />
	<property name="libdir" value="${basedir}/lib" />
	<!-- Select one Windows SWT at build time; the matching Java runtime must
	     have the same architecture. -->
	<property name="windows.swt.arch" value="arm64" />
	<condition property="swtdir" value="${libdir}/windows/arm64" else="${libdir}/windows">
		<equals arg1="${windows.swt.arch}" arg2="arm64" />
	</condition>
	<property name="macswtdir" value="${libdir}/macintosh" />
	<property name="resdir" value="${basedir}/res" />
	<property name="distdir" value="${basedir}/dist" />
	<property name="builddir" value="${basedir}/build" />
	<property name="java_runtime_res" value="edu/cmu/cs/hcii/cogtool/resources" />
	<property name="clisp" value="${basedir}/lisp" />
	<property name="launch4j.dir" location="${libdir}/build-only/launch4j" />
	<property name="java.library.path" value="${java.library.path};${swtdir}" />

	<!-- Classpath: setup once, used everywhere. -->
	<path id="classpath">
		<fileset dir="${libdir}">
			<include name="*.jar" />
		</fileset>
		<fileset dir="${libdir}/build-only">
			<include name="*.jar" />
		</fileset>
		<fileset dir="${swtdir}">
			<include name="swt.jar" />
		</fileset>
		<pathelement path="${builddir}" />
	</path>

	<path id="mac-classpath">
		<fileset dir="${libdir}">
			<include name="*.jar" />
		</fileset>
		<fileset dir="${libdir}/build-only">
			<include name="*.jar" />
		</fileset>
		<fileset dir="${macswtdir}">
			<include name="swt.jar" />
		</fileset>
		<pathelement path="${builddir}" />
	</path>

	<!-- Run packaged-application checks on the host's graphical desktop. -->
	<target name="test-setup">
		<condition property="test.host.windows"><os family="windows" /></condition>
		<condition property="test.host.mac"><os family="mac" /></condition>
		<condition property="test.host.supported"><or><isset property="test.host.windows" /><isset property="test.host.mac" /></or></condition>
		<fail unless="test.host.supported" message="Platform tests must run on Windows or Apple Silicon macOS with a graphical desktop." />
		<condition property="test.platform" value="windows-amd64" else="macos-arm64"><isset property="test.host.windows" /></condition>
		<condition property="test.platform.valid"><or>
			<and><isset property="test.host.windows" /><or><equals arg1="${test.platform}" arg2="windows-amd64" /><equals arg1="${test.platform}" arg2="windows-x86" /></or></and>
			<and><isset property="test.host.mac" /><equals arg1="${test.platform}" arg2="macos-arm64" /></and>
		</or></condition>
		<fail unless="test.platform.valid" message="test.platform must match the host OS: windows-amd64, windows-x86, or macos-arm64." />
		<condition property="test.app.provided"><isset property="test.app" /></condition>
		<condition property="test.build.windows"><and><isset property="test.host.windows" /><not><isset property="test.app.provided" /></not></and></condition>
		<condition property="test.missing.x86.package"><and><isset property="test.build.windows" /><equals arg1="${test.platform}" arg2="windows-x86" /></and></condition>
		<fail if="test.missing.x86.package" message="The build has no 32-bit x86 SWT package. Set test.app to a compatible extracted package when one is available." />
		<condition property="test.app" value="${builddir}/windows-x86_64/stage/CogTool" else="${distdir}/CogTool.app"><isset property="test.host.windows" /></condition>
		<condition property="test.python" value="python" else="python3"><isset property="test.host.windows" /></condition>
	</target>

	<target name="test-stage-windows" depends="test-setup" if="test.build.windows">
		<ant antfile="${basedir}/build.xml" target="windows-stage" inheritAll="false">
			<property name="windows.swt.arch" value="x86_64" />
		</ant>
	</target>

	<target name="test" depends="test-stage-windows" description="Run the packaged platform suite on Windows or Apple Silicon macOS.">
		<exec executable="${test.python}" failonerror="true">
			<arg file="${basedir}/tests/platform-suite.py" />
			<arg value="--platform" /><arg value="${test.platform}" />
			<arg value="--app" /><arg file="${test.app}" />
		</exec>
	</target>

	<!-- Deletes all generated output for a clean rebuild. -->
	<target name="clean" description="Deletes all generated output for a clean rebuild.">
		<delete includeemptydirs="true">
			<fileset dir="${distdir}" includes="**/*" />
		</delete>
		<delete includeemptydirs="true">
			<fileset dir="${builddir}" includes="**/*" />
		</delete>
	</target>

	<!-- Compiles java source with javac. -->
	<target name="validate-windows-swt">
		<condition property="windows.swt.arch.valid">
			<or><equals arg1="${windows.swt.arch}" arg2="x86_64" /><equals arg1="${windows.swt.arch}" arg2="arm64" /></or>
		</condition>
		<fail unless="windows.swt.arch.valid" message="windows.swt.arch must be x86_64 or arm64" />
	</target>

	<target name="validate-release-version">
		<fail unless="release.version" message="release.properties must define a version." />
		<condition property="release.version.matches"><equals arg1="${version}" arg2="${release.version}" /></condition>
		<fail unless="release.version.matches" message="The build version must match release.properties (${release.version}); edit that file instead of overriding version." />
	</target>

	<target name="compile" depends="validate-release-version,validate-windows-swt" description="Compiles java source with javac.">
		<javac srcdir="${srcroot}" destdir="${builddir}" debug="on" fork="true" source="${jlevel}" target="${jlevel}">
			<classpath refid="classpath" />
			<include name="**/*.java" />
		</javac>

		<javac srcdir="${macsrcroot}" destdir="${builddir}" debug="on" fork="true" source="${jlevel}" target="${jlevel}">
			<classpath refid="mac-classpath" />
			<include name="**/*.java" />
		</javac>

		<!-- Copy the resources dir into the build dir -->
		
		<copy todir="${builddir}/${java_runtime_res}" overwrite="true">
			<fileset dir="java/${java_runtime_res}"/>
		</copy>
		
	</target>
	
	<condition property="os.mac">
		<os family="mac" />
	</condition>

	<property name="help.bundle" location="${builddir}/help/CogTool.help" />
	<property name="help.pages" location="${help.bundle}/Contents/Resources/en.lproj" />
	<!-- Prefer an optional project-local Ruby; callers can override this property. -->
	<condition property="help.bundle.executable" value="${basedir}/.local/ruby/bin/bundle" else="bundle">
		<available file="${basedir}/.local/ruby/bin/bundle" />
	</condition>
	<dirname property="help.bundle.dir" file="${help.bundle.executable}" />
	<condition property="help.tools.path" value="${help.bundle.dir}${path.separator}${env.PATH}" else="${env.PATH}">
		<available file="${help.bundle.executable}" type="file" />
	</condition>

	<target name="help-check">
		<fail unless="os.mac" message="Building the indexed macOS Help Book requires macOS and hiutil." />
		<exec dir="${basedir}/docs" executable="${help.bundle.executable}" resultproperty="help.bundle.check.result" failifexecutionfails="false">
			<env key="PATH" path="${help.tools.path}" />
			<arg value="check" />
		</exec>
		<condition property="help.bundle.check.ok"><equals arg1="${help.bundle.check.result}" arg2="0" /></condition>
		<fail unless="help.bundle.check.ok" message="Jekyll dependencies are unavailable to ${help.bundle.executable}. Install Ruby 3.2+ and Bundler, then run bundle install in docs/. Use -Dhelp.bundle.executable=/path/to/bundle if needed." />
	</target>

	<target name="help-copy" depends="help-check" description="Build the Help Book from the Jekyll documentation.">
		<delete dir="${builddir}/help" />
		<exec dir="${basedir}/docs" executable="${help.bundle.executable}" failonerror="true">
			<env key="PATH" path="${help.tools.path}" />
			<arg value="exec" /><arg value="jekyll" /><arg value="build" />
			<arg value="--config" /><arg value="_config.yml,_config_helpbundle.yml" />
			<arg value="--destination" /><arg file="${builddir}/help/site" />
		</exec>
		<copy todir="${help.bundle}">
			<fileset dir="${resdir}/CogTool.tmp/Contents/Resources/CogTool.help" includes="Contents/Info.plist,Contents/Resources/en.lproj/InfoPlist.strings" />
		</copy>
		<copy todir="${help.pages}"><fileset dir="${builddir}/help/site/help" /></copy>
		<copy todir="${help.pages}/assets/user-guide/media"><fileset dir="${basedir}/docs/assets/user-guide/media" /></copy>
		<!-- The website uses root-relative image URLs; a Help Book is loaded from disk. -->
		<replace dir="${help.pages}" includes="**/*.html" token="/assets/user-guide/media/" value="assets/user-guide/media/" />
	</target>

	<target name="help-index" depends="help-copy" description="Index the generated macOS Help Book.">
		<exec dir="${help.pages}" executable="hiutil" failonerror="true">
			<arg value="-I" /><arg value="corespotlight" /><arg value="-Caf" /><arg value="help.cshelpindex" /><arg value="." />
		</exec>
		<exec dir="${help.pages}" executable="hiutil" failonerror="true">
			<arg value="-I" /><arg value="lsm" /><arg value="-Caf" /><arg value="help.helpindex" /><arg value="." />
		</exec>
	</target>

	<taskdef name="launch4j" classname="net.sf.launch4j.ant.Launch4jTask" classpath="${launch4j.dir}/launch4j.jar:${launch4j.dir}/lib/xstream.jar" />

	<!-- Preserve the existing ARM64 local configuration for combined builds. -->
	<condition property="windows.jre.arm64.dir" value="${windows.jre.dir}">
		<isset property="windows.jre.dir" />
	</condition>

	<!-- Check both runtimes before the default build removes old output. -->
	<target name="validate-package-all" depends="validate-release-version,validate-windows-swt">
		<fail unless="windows.jre.arm64.dir" message="Set windows.jre.arm64.dir to an ARM64 Windows Java runtime in build.local.properties." />
		<fail unless="windows.jre.x86_64.dir" message="Set windows.jre.x86_64.dir to an x86-64 Windows Java runtime in build.local.properties." />
		<exec executable="python3" failonerror="true">
			<env key="PATH" path="${windows.tools.path}" />
			<arg value="-c" />
			<arg value="import shutil, sys; missing = [name for name in ('wixl', 'msibuild', 'msiinfo') if not shutil.which(name)]; missing and sys.exit('Missing installer tools: ' + ', '.join(missing))" />
		</exec>
		<exec executable="python3" failonerror="true">
			<arg file="${basedir}/tools/build-windows-msi.py" />
			<arg value="--check-runtime" /><arg file="${windows.jre.arm64.dir}" />
			<arg value="--arch" /><arg value="arm64" />
		</exec>
		<exec executable="python3" failonerror="true">
			<arg file="${basedir}/tools/build-windows-msi.py" />
			<arg value="--check-runtime" /><arg file="${windows.jre.x86_64.dir}" />
			<arg value="--arch" /><arg value="x86_64" />
		</exec>
		<property name="skip.legacy.windows" value="true" />
	</target>

	<!-- Fork Ant to isolate architecture-specific immutable properties. -->
	<macrodef name="package-windows-msi">
		<attribute name="arch" />
		<attribute name="runtime" />
		<sequential>
			<java classname="org.apache.tools.ant.launch.Launcher" fork="true" failonerror="true" dir="${basedir}">
				<classpath><pathelement location="${ant.home}/lib/ant-launcher.jar" /></classpath>
				<arg value="-f" /><arg file="${basedir}/build.xml" />
				<arg value="-Dwindows.swt.arch=@{arch}" />
				<arg value="-Dwindows.jre.dir=@{runtime}" />
				<arg value="-Dwindows.tools.path=${windows.tools.path}" />
				<arg value="-Dbuilddir=${builddir}" /><arg value="-Ddistdir=${distdir}" />
				<arg value="-Dversion=${version}" /><arg value="-Drevision=${revision}" />
				<arg value="-Djlevel=${jlevel}" />
				<arg value="windows-msi" />
			</java>
		</sequential>
	</macrodef>

	<target name="package-all" depends="validate-package-all,package" description="Builds the Mac package and both Windows MSIs.">
		<package-windows-msi arch="arm64" runtime="${windows.jre.arm64.dir}" />
		<package-windows-msi arch="x86_64" runtime="${windows.jre.x86_64.dir}" />
	</target>

	<!-- Packages build output and resources into runnable packages. -->
	<target name="package" depends="validate-release-version,help-check,clean,compile,help-index,package-artifacts" description="Packages build output and resources into runnable packages." />

	<!-- Reuse the help files already in the bundle template when Jekyll is unavailable. -->
	<target name="package-without-help" depends="validate-release-version,clean,compile,package-artifacts" description="Packages using the existing help bundle." />

	<!-- A portable Windows ZIP can be assembled on any host with a JDK and Ant. -->
	<target name="windows-stage" depends="validate-release-version,validate-windows-swt">
		<property name="windows.workdir" location="${builddir}/windows-${windows.swt.arch}" />
		<property name="windows.classes" location="${windows.workdir}/classes" />
		<property name="windows.stage" location="${windows.workdir}/stage/CogTool" />
		<delete dir="${windows.workdir}" />
		<mkdir dir="${windows.classes}" />
		<mkdir dir="${windows.stage}/lib" />
		<mkdir dir="${distdir}" />
		<javac srcdir="${srcroot}" destdir="${windows.classes}" debug="on" fork="true" source="${jlevel}" target="${jlevel}" includeantruntime="false">
			<classpath>
				<fileset dir="${libdir}" includes="*.jar" />
				<fileset dir="${libdir}/build-only" includes="*.jar" />
				<fileset dir="${swtdir}" includes="swt.jar" />
				<pathelement location="${windows.classes}" />
			</classpath>
		</javac>
		<copy todir="${windows.classes}/${java_runtime_res}"><fileset dir="${srcroot}/${java_runtime_res}" /></copy>

		<path id="windows.runtime.classpath">
			<fileset dir="${libdir}" includes="*.jar" />
			<fileset dir="${swtdir}" includes="swt.jar" />
		</path>
		<pathconvert property="windows.manifest.classpath" pathsep=" " refid="windows.runtime.classpath">
			<mapper><chainedmapper><flattenmapper /><globmapper from="*" to="lib/*" /></chainedmapper></mapper>
		</pathconvert>
		<jar destfile="${windows.stage}/CogTool.jar" basedir="${windows.classes}">
			<manifest>
				<attribute name="Main-Class" value="edu.cmu.cs.hcii.cogtool.CogTool" />
				<attribute name="Class-Path" value="${windows.manifest.classpath}" />
			</manifest>
		</jar>
		<copy todir="${windows.stage}/lib"><fileset dir="${libdir}" includes="*.jar" /></copy>
		<copy file="${swtdir}/swt.jar" todir="${windows.stage}/lib" />
		<copy file="${macswtdir}/EPL-2.0.txt" tofile="${windows.stage}/lib/SWT-EPL-2.0.txt" />
		<copy todir="${windows.stage}/clisp-win"><fileset dir="${basedir}/clisp-win" /></copy>
		<copy todir="${windows.stage}/XUL-win"><fileset dir="${basedir}/XUL-win" /></copy>
		<copy file="${basedir}/LICENSE.txt" todir="${windows.stage}" />
		<copy file="${resdir}/CogTool.ico" todir="${windows.stage}" />
		<tstamp><format property="windows.buildtime" pattern="MM/dd/yyyy-hh:mm" /></tstamp>
		<copy file="${resdir}/windows-portable/CogTool.bat" todir="${windows.stage}">
			<filterset><filter token="VERSION" value="${version}" /><filter token="REVISION" value="${revision}" /><filter token="BUILDTIME" value="${windows.buildtime}" /></filterset>
		</copy>
		<copy file="${resdir}/windows-portable/README.txt" todir="${windows.stage}">
			<filterset><filter token="ARCH" value="${windows.swt.arch}" /></filterset>
		</copy>
		<fixcrlf srcdir="${windows.stage}" includes="CogTool.bat,README.txt" eol="crlf" />
		<antcall target="windows-copy-runtime" />
	</target>

	<target name="windows-zip" depends="windows-stage" description="Builds a portable Windows ZIP without NSIS.">
		<zip destfile="${distdir}/CogTool-Windows-${windows.swt.arch}-${versionclean}${revision.suffix}.zip" basedir="${windows.workdir}/stage" />
	</target>

	<target name="windows-msi" depends="windows-stage" description="Builds a Windows MSI using wixl and a supplied Windows JRE.">
		<fail unless="windows.jre.dir" message="Set windows.jre.dir to a Windows Java runtime matching windows.swt.arch." />
		<exec executable="python3" failonerror="true">
			<env key="PATH" path="${windows.tools.path}" />
			<arg file="${basedir}/tools/build-windows-msi.py" />
			<arg value="--stage" /><arg file="${windows.stage}" />
			<arg value="--arch" /><arg value="${windows.swt.arch}" />
			<arg value="--version" /><arg value="${version}" />
			<arg value="--revision" /><arg value="${revision}" />
			<arg value="--buildtime" /><arg value="${windows.buildtime}" />
			<arg value="--icon" /><arg file="${resdir}/CogTool.ico" />
			<arg value="--output" /><arg file="${distdir}/CogTool-Windows-${windows.swt.arch}-${versionclean}${revision.suffix}.msi" />
		</exec>
	</target>

	<target name="windows-copy-runtime" if="windows.jre.dir">
		<available file="${windows.jre.dir}/bin/java.exe" property="windows.runtime.has.java" />
		<fail unless="windows.runtime.has.java" message="windows.jre.dir must point to a Windows Java runtime containing bin/java.exe" />
		<copy todir="${windows.stage}/jre"><fileset dir="${windows.jre.dir}" /></copy>
	</target>

	<target name="package-artifacts">
		<condition property="help.template.exclude" value="Contents/Resources/CogTool.help/**" else="__no_help_exclusion__">
			<available file="${help.bundle}" type="dir" />
		</condition>

		<tstamp>
			<format property="buildtime" pattern="MM/dd/yyyy-hh:mm" />
		</tstamp>

		<!-- Setup property for manifest classpath entries. -->
		<pathconvert property="manifest.classpath" pathsep=" ">
			<path refid="classpath" />
			<mapper>
				<chainedmapper>
					<flattenmapper />
					<globmapper from="*" to="./lib/*" />
				</chainedmapper>
			</mapper>
		</pathconvert>

		<!-- Create a double-clickable app jar with classpath entries. -->
		<jar destfile="${distdir}/CogTool.jar" compress="true" index="false">
			<manifest>
				<attribute name="Class-Path" value="${manifest.classpath}" />
				<attribute name="Main-Class" value="edu.cmu.cs.hcii.cogtool.CogTool" />
			</manifest>
			<!-- Help is packaged separately; the staging tree also contains the full website. -->
			<fileset dir="${builddir}" excludes="help/**" />
		</jar>

		<!-- Create a Mac "app" bundle by copying the tmp bundle. -->
		<copy todir="${distdir}/CogTool.app" overwrite="true">
			<fileset dir="${resdir}/CogTool.tmp" excludes="${help.template.exclude}" />
		</copy>
		<copy todir="${distdir}/CogTool.app/Contents/Resources/CogTool.help">
			<fileset dir="${help.bundle}" erroronmissingdir="false" />
		</copy>

		<!-- Launch Services requires a native entry point; the shell script is a resource. -->
        <copy file="${libdir}/macintosh/cogtool-launcher" tofile="${distdir}/CogTool.app/Contents/MacOS/cogtool-launcher" />
        <chmod perm="a+x" file="${distdir}/CogTool.app/Contents/MacOS/cogtool-launcher" />
        <copy file="${libdir}/macintosh/cogtoolstart" tofile="${distdir}/CogTool.app/Contents/Resources/cogtoolstart" />
        <!-- The launcher needs these links before Java is available. -->
        <copy file="${srcroot}/${java_runtime_res}/release.properties" tofile="${distdir}/CogTool.app/Contents/Resources/release.properties" />

        <copy file="${libdir}/macintosh/export-csv-kludge" tofile="${distdir}/CogTool.app/Contents/Resources/export-csv-kludge" />
        <chmod perm="a+x" file="${distdir}/CogTool.app/Contents/Resources/export-csv-kludge" />

		<copy todir="${distdir}/CogTool.app/Contents/Resources/Java/dll/">
			<fileset dir="${macswtdir}">
				<include name="*.jnilib" />
			</fileset>
		</copy>
		<copy todir="${distdir}/CogTool.app/Contents/Resources/Java/">
			<fileset dir="${macswtdir}">
				<include name="*.jar" />
			</fileset>
		</copy>
		<!-- Keep the ARM64 native libraries in the bundle so SWT need not
		     extract them into the user's home directory at startup. -->
		<unzip src="${macswtdir}/swt-arm64.jar" dest="${distdir}/CogTool.app/Contents/Resources/Java/dll/arm64">
			<patternset><include name="*.jnilib" /></patternset>
		</unzip>
		<copy file="${macswtdir}/EPL-2.0.txt" todir="${distdir}/CogTool.app/Contents/Resources/Java/" />

		<!-- Copy the rest of the libdir to the Mac bundle. -->
		<copy todir="${distdir}/CogTool.app/Contents/Resources/Java/">
			<fileset dir="${libdir}">
				<include name="*.jar" />
			</fileset>
		</copy>

		<!-- Setup the Classpath plist value. -->
		<fileset dir="${distdir}/CogTool.app/Contents/Resources/Java" id="distjars">
			<include name="*.jar" />
		</fileset>

		<pathconvert pathsep=":$JAVAROOT/" property="distjarstr" refid="distjars">
			<mapper type="flatten" />
		</pathconvert>

		<echo message="${revision}" />

		<replace file="${distdir}/CogTool.app/Contents/Info.plist" token="DISTJARSTR" value="${distjarstr}" />
		<replace file="${distdir}/CogTool.app/Contents/Info.plist" token="VERSION" value="${version}" />
		<replace file="${distdir}/CogTool.app/Contents/Info.plist" token="REVISION" value="${revision}" />
		<replace file="${distdir}/CogTool.app/Contents/Info.plist" token="BUILDTIME" value="${buildtime}" />
		<replace file="${distdir}/CogTool.app/Contents/Info.plist" token="VERSTRING" value="${version}" />

		<!-- Copy the app jar to the Mac bundle. -->
		<copy file="${distdir}/CogTool.jar" todir="${distdir}/CogTool.app/Contents/Resources/Java/" />

		<!-- Compile the prediction helpers at build time so running them needs only Java. -->
		<mkdir dir="${builddir}/prediction-tests" />
		<javac srcdir="${basedir}/tests" destdir="${builddir}/prediction-tests" debug="on" fork="true" source="${jlevel}" target="${jlevel}" includeantruntime="false">
			<classpath refid="mac-classpath" />
			<include name="ProjectPredictions.java" />
			<include name="PredictionSmoke.java" />
		</javac>
		<jar destfile="${distdir}/CogTool.app/Contents/Resources/cogtool-prediction-tests.jar" basedir="${builddir}/prediction-tests" />
		<delete dir="${builddir}/prediction-tests" />

		<!-- Copy the clisp dist to the Mac bundle. -->
		<copy todir="${distdir}/CogTool.app/Contents/Resources/clisp-mac-intel/">
			<fileset dir="${basedir}/clisp-mac-intel">
				<include name="*" />
			</fileset>
		</copy>

		<!-- Chmod the clisp executable. -->
		<chmod file="${distdir}/CogTool.app/Contents/Resources/clisp-mac-intel/lisp.run" perm="a+x" />

		<!-- Apple Silicon uses its own CLISP executable and compatible ACT-R image. -->
		<copy todir="${distdir}/CogTool.app/Contents/Resources/clisp-mac-arm64/">
			<fileset dir="${basedir}/clisp-mac-arm64" />
		</copy>
		<chmod file="${distdir}/CogTool.app/Contents/Resources/clisp-mac-arm64/lisp.run" perm="a+x" />

		<!-- Copy the Mac XUL implementation into the bundle. -->
		<copy todir="${distdir}/CogTool.app/Contents/Resources/XUL-mac/">
		        <fileset dir="${basedir}/XUL-mac"/>
		</copy>

		<!-- Chmod the XUL stuff. -->
		<chmod dir="${distdir}/CogTool.app/Contents/Resources/XUL-mac" includes="XUL,xulrunner*,*.*lib,*.sh" perm="a+x"/>

		<!-- Sign only after all bundle contents and metadata have been written. -->
		<antcall target="sign-mac-bundle" />

		<!-- Prepare .tgz for Mac OS X download. -->
		<tar destfile="${distdir}/CogToolMac-${versionclean}${revision.suffix}.tgz" compression="gzip" longfile="warn">
			<tarfileset dir="${distdir}/" mode="755">
				<include name="CogTool.app/**" />
			</tarfileset>
		</tar>

		<!-- Build a Windows launcher .exe via launch4j. -->
		<condition property="os.windows">
			<os family="windows" />
		</condition>
		<antcall target="package-windows" />

	</target>

	<target name="sign-mac-bundle" if="os.mac">
		<exec executable="/usr/bin/codesign" failonerror="true">
			<arg value="--force" />
			<arg value="--sign" />
			<arg value="-" />
			<arg file="${distdir}/CogTool.app" />
		</exec>
	</target>

	<target name="package-windows" if="os.windows" unless="skip.legacy.windows">
		<!-- Insert Build Date, etc. -->
		<replace file="${basedir}/res/launch4j.cfg.xml" token="VERSION" value="${version}" />
		<replace file="${basedir}/res/launch4j.cfg.xml" token="REVISION" value="${revision}" />
		<replace file="${basedir}/res/launch4j.cfg.xml" token="BUILDTIME" value="${buildtime}" />
		<replace file="${basedir}/res/launch4j.cfg.xml" token="VERSTRING" value="${version}" />
		<replace file="${basedir}/res/launch4j.cfg.xml" token="EXEVERS" value="${exeversion}" />
		<replace file="${basedir}/res/cogtool.nsi" token="VERSTRING" value="${version}" />
		<replace file="${basedir}/res/cogtool.nsi" token="EXEVERS" value="${exeversion}" />
		<replace file="${basedir}/res/cogtool.nsi" token="SETUPFILE" value="..\dist\CogTool-${versionclean}-setup.exe" />

		<!-- Build a Windows launcher .exe via launch4j. -->
		<launch4j configFile="${basedir}/res/launch4j.cfg.xml" />

		<!-- Build a Windows installer .exe w/ jar & clisp. -->
		<exec executable="C:\Program Files (x86)\NSIS\makensis.exe" vmlauncher="false" resolveexecutable="true">
			<arg value="/XSetCompressor /FINAL /SOLID lzma" />
			<arg value="/DCOGTOOL_SWT_JAR=${swtdir}/swt.jar" />
			<arg file="${basedir}/res/cogtool.nsi" />
		</exec>

		<!-- Remove Build Date, etc. -->
		<replace file="${basedir}/res/launch4j.cfg.xml" token="${version}" value="VERSION" />
		<replace file="${basedir}/res/launch4j.cfg.xml" token="${revision}" value="REVISION" />
		<replace file="${basedir}/res/launch4j.cfg.xml" token="${buildtime}" value="BUILDTIME" />
		<replace file="${basedir}/res/launch4j.cfg.xml" token="${version}" value="VERSTRING" />
		<replace file="${basedir}/res/launch4j.cfg.xml" token="${exeversion}" value="EXEVERS" />
		<replace file="${basedir}/res/cogtool.nsi" token="${version}" value="VERSTRING" />
		<replace file="${basedir}/res/cogtool.nsi" token="${exeversion}" value="EXEVERS" />
		<replace file="${basedir}/res/cogtool.nsi" token="..\dist\CogTool-${versionclean}-r${revision}-setup.exe" value="SETUPFILE" />

	</target>

</project>
